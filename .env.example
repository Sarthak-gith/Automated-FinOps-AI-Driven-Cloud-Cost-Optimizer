# Local SQLite store; relative to repository root.
DATABASE_URL=sqlite:///./backend/data/finops.db

# Replace this value before sharing the app outside a trusted local machine.
APP_SECRET_KEY=replace-with-a-long-random-local-secret

# The only provider implemented in this academic version.
CLOUD_PROVIDER=simulated
SIM_RESOURCE_COUNT=20
SIM_HISTORY_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional password overrides, used only when the demo users are first created.
# DEMO_ADMIN_PASSWORD=your-local-admin-password
# DEMO_ANALYST_PASSWORD=your-local-analyst-password
# DEMO_VIEWER_PASSWORD=your-local-viewer-password

# Optional frontend override; Vite reads the repository-root .env file.
VITE_API_URL=http://127.0.0.1:8000/api
